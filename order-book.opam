# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Price-time priority limit order book with matching (OxCaml)"
maintainer: ["winterchill-trading"]
authors: ["winterchill-trading"]
license: "MIT"
homepage: "https://github.com/winterchill-trading/order-book"
bug-reports: "https://github.com/winterchill-trading/order-book/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.17"}
  "core"
  "fixed-decimal"
  "exchange-core"
  "ppx_jane"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/winterchill-trading/order-book.git"
